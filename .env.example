OPENAI_API_KEY=sk-...
GEOAGENT_MODEL=gpt-4o-mini
GEOAGENT_CACHE_DIR=.cache/osmnx
GEOAGENT_MAPS_DIR=maps
GEOAGENT_MAX_TURNS=8

# Only set these if your network can't reach OSMnx's default Overpass mirror
# (overpass-api.de). Leave unset to use OSMnx's normal endpoint + rate limiting,
# which respects the public Overpass API's usage policy.
# GEOAGENT_OVERPASS_URL=https://overpass.kumi.systems/api
# GEOAGENT_OVERPASS_RATE_LIMIT=false

# Optional: hosting (see "Deploying to AWS" in the README). All unset by default.
# GEOAGENT_DATA_S3_URI=s3://your-data-bucket/data   # download the offline WA street data at startup
# GEOAGENT_DATA_HF_REPO=yourname/wa-street-data     # ...or from a public Hugging Face dataset
# GEOAGENT_ENABLE_ROUTING=false                     # mining-only (for hosts without the street data)
# GEOAGENT_MAPS_S3_BUCKET=your-maps-bucket          # publish map exports as presigned links
# GEOAGENT_MAX_SESSION_MESSAGES=30                  # questions per visitor session (0 = unlimited)
# GEOAGENT_MAX_INPUT_CHARS=600                      # longest accepted message (0 = unlimited)
